{
  "name": "@checkbeforeyoushop/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for CheckBeforeYouShop's public shopping portal API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/sdk.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
